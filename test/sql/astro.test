# name: test/sql/astro.test
# description: test astro extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT astro_angular_separation(45.0, 30.0, 46.0, 31.0);
----
Catalog Error: Scalar Function with name astro_angular_separation does not exist!

# Require statement will ensure this test is run with this extension loaded
require astro

# ============================================
# Physical Constants
# ============================================

query I
SELECT astro_const_c() = 299792458;
----
true

query I
SELECT astro_const_G() > 6.67e-11 AND astro_const_G() < 6.68e-11;
----
true

query I
SELECT astro_const_AU() > 1.49e11;
----
true

query I
SELECT astro_const_M_sun() > 1.98e30;
----
true

# ============================================
# Unit Conversions
# ============================================

query I
SELECT astro_unit_AU(1.0) = astro_const_AU();
----
true

query I
SELECT astro_unit_pc(1.0) > 3e16;
----
true

query I
SELECT astro_unit_length_to_m(1.0, 'AU') = astro_const_AU();
----
true

query I
SELECT astro_unit_mass_to_kg(1.0, 'M_sun') = astro_const_M_sun();
----
true

query I
SELECT astro_unit_time_to_s(1.0, 'yr') > 3.15e7;
----
true

# ============================================
# Angular Separation
# ============================================

query I
SELECT astro_angular_separation(45.0, 30.0, 46.0, 31.0) > 0;
----
true

query I
SELECT astro_angular_separation(45.0, 30.0, 45.0, 30.0) = 0;
----
true

query I
SELECT astro_angular_separation(0.0, 0.0, 180.0, 0.0) = 180.0;
----
true

# ============================================
# Coordinate Transformations
# ============================================

query I
SELECT (astro_radec_to_xyz(0.0, 0.0, 1.0)).x_m = 1.0;
----
true

query I
SELECT (astro_radec_to_xyz(90.0, 0.0, 1.0)).y_m > 0.99;
----
true

query I
SELECT (astro_radec_to_xyz(0.0, 90.0, 1.0)).z_m > 0.99;
----
true

# ============================================
# Photometry
# ============================================

query I
SELECT astro_mag_to_flux(15.0, 25.0) > 0;
----
true

query I
SELECT astro_mag_to_flux(10.0, 25.0) > astro_mag_to_flux(15.0, 25.0);
----
true

query I
SELECT astro_flux_to_mag(1000.0, 25.0) > 0;
----
true

query I
SELECT astro_absolute_mag(10.0, 100.0) = 5.0;
----
true

query I
SELECT astro_distance_modulus(1000.0) = 10.0;
----
true

# ============================================
# Cosmology
# ============================================

query I
SELECT astro_luminosity_distance(0.1, 70.0) > 0;
----
true

query I
SELECT astro_luminosity_distance(0.5, 70.0) > astro_luminosity_distance(0.1, 70.0);
----
true

query I
SELECT astro_comoving_distance(1.0, 70.0) > 0;
----
true

# ============================================
# Body Models
# ============================================

query I
SELECT (astro_body_star_main_sequence(1.0)).mass_kg > 1.9e30;
----
true

query I
SELECT (astro_body_star_main_sequence(1.0)).radius_m > 6.9e8;
----
true

query I
SELECT (astro_body_star_main_sequence(1.0)).body_type = 'star_main_sequence';
----
true

query I
SELECT (astro_body_star_white_dwarf(0.6)).body_type = 'star_white_dwarf';
----
true

query I
SELECT (astro_body_star_neutron(1.4)).radius_m < 20000;
----
true

query I
SELECT (astro_body_black_hole(10.0)).radius_m > 0;
----
true

query I
SELECT (astro_body_planet_rocky(1.0)).body_type = 'planet_rocky';
----
true

query I
SELECT (astro_body_planet_gas_giant(1.0)).body_type = 'planet_gas_giant';
----
true

query I
SELECT (astro_body_planet_ice_giant(17.0)).body_type = 'planet_ice_giant';
----
true

query I
SELECT (astro_body_asteroid(500.0, 2000.0)).body_type = 'asteroid';
----
true

query I
SELECT (astro_body_brown_dwarf(50.0)).body_type = 'brown_dwarf';
----
true

# ============================================
# Orbital Mechanics
# ============================================

query I
SELECT astro_orbit_period(1.496e11, 1.989e30) > 3.1e7;
----
true

query I
SELECT astro_orbit_mean_motion(1.496e11, 1.989e30) > 0;
----
true

# ============================================
# Spatial Sectors
# ============================================

query I
SELECT (astro_sector_id(1.0, 0.0, 0.0, 3)).level = 3;
----
true

# ============================================
# NULL Handling
# ============================================

query I
SELECT astro_angular_separation(NULL, 30.0, 46.0, 31.0) IS NULL;
----
true

query I
SELECT astro_mag_to_flux(NULL, 25.0) IS NULL;
----
true

query I
SELECT astro_distance_modulus(NULL) IS NULL;
----
true

# ============================================
# Batch Processing
# ============================================

query I
SELECT COUNT(*) FROM (
    SELECT astro_angular_separation(ra, dec, ra+1, dec+1) as sep
    FROM (VALUES (0.0, 0.0), (45.0, 30.0), (90.0, 60.0), (180.0, -30.0)) AS coords(ra, dec)
) WHERE sep > 0;
----
4

query I
SELECT COUNT(*) FROM (
    SELECT
        astro_angular_separation(ra, dec, 0, 0) as sep,
        astro_mag_to_flux(mag, 25.0) as flux,
        astro_distance_modulus(dist) as dm
    FROM (VALUES
        (0.0, 0.0, 15.0, 100.0),
        (45.0, 30.0, 12.5, 500.0),
        (90.0, -45.0, 18.2, 1000.0)
    ) AS data(ra, dec, mag, dist)
) WHERE sep >= 0 AND flux > 0 AND dm > 0;
----
3

# ============================================
# Dust Extinction (CCM89)
# ============================================

# A_V = R_V * E(B-V)
query I
SELECT astro_extinction_av(1.0, 3.1) = 3.1;
----
true

# A_V = 0 when E(B-V) = 0
query I
SELECT astro_extinction_av(0.0, 3.1) = 0.0;
----
true

# V-band normalization: A(λ)/A_V should be ~1.0 at 5494.5 Å
query I
SELECT abs(astro_extinction_alambda(5494.5, 1.0, 3.1) - 1.0) < 0.001;
----
true

# Extinction in V-band should match alambda at V wavelength
query I
SELECT abs(astro_extinction_band('V', 1.0, 3.1) - astro_extinction_alambda(5494.5, 1.0, 3.1)) < 0.001;
----
true

# B-band extinction should be higher than V-band (shorter wavelength)
query I
SELECT astro_extinction_band('B', 1.0, 3.1) > astro_extinction_band('V', 1.0, 3.1);
----
true

# K-band extinction should be lower than V-band (longer wavelength, infrared)
query I
SELECT astro_extinction_band('K', 1.0, 3.1) < astro_extinction_band('V', 1.0, 3.1);
----
true

# J-band should have lower extinction than B-band
query I
SELECT astro_extinction_band('J', 1.0, 3.1) < astro_extinction_band('B', 1.0, 3.1);
----
true

# Dereddening magnitude subtracts extinction
query I
SELECT astro_mag_deredden(15.5, 1.25) = 14.25;
----
true

# Dereddening flux increases the flux
query I
SELECT astro_flux_deredden(1000.0, 1.0) > 1000.0;
----
true

# Flux correction factor for 1 mag extinction should be ~2.512
query I
SELECT abs(astro_flux_deredden(1.0, 1.0) - 2.51188643150958) < 0.0001;
----
true

# Color excess calculation: E = (m1 - m2) - intrinsic
query I
SELECT abs(astro_color_excess(12.5, 11.8, 0.3) - 0.4) < 0.0001;
----
true

# Zero color excess when observed equals intrinsic
query I
SELECT astro_color_excess(12.5, 12.0, 0.5) = 0.0;
----
true

# Case-insensitive band names
query I
SELECT astro_extinction_band('v', 1.0, 3.1) = astro_extinction_band('V', 1.0, 3.1);
----
true

# R_V affects the extinction ratio
query I
SELECT astro_extinction_alambda(4400.0, 1.0, 5.0) != astro_extinction_alambda(4400.0, 1.0, 3.1);
----
true

# Default R_V=3.1 overloads
query I
SELECT astro_extinction_av(1.0) = astro_extinction_av(1.0, 3.1);
----
true

query I
SELECT astro_extinction_alambda(5000.0, 1.5) = astro_extinction_alambda(5000.0, 1.5, 3.1);
----
true

query I
SELECT astro_extinction_band('B', 2.0) = astro_extinction_band('B', 2.0, 3.1);
----
true

# ============================================
# Sidereal Time & Observing
# ============================================

# astro_jd_from_timestamp: Unix epoch must be JD 2440587.5
query I
SELECT astro_jd_from_timestamp(TIMESTAMP '1970-01-01 00:00:00') = 2440587.5;
----
true

# astro_jd_from_timestamp: J2000.0 epoch (2000-01-01 12:00 UT) is JD 2451545.0
query I
SELECT abs(astro_jd_from_timestamp(TIMESTAMP '2000-01-01 12:00:00') - 2451545.0) < 1e-6;
----
true

# GMST at J2000.0: should equal the formula constant 280.46061837 / 15 = 18.6974 h
query I
SELECT abs(astro_gmst(2451545.0) - 18.69737456) < 0.001;
----
true

# GMST is in [0, 24)
query I
SELECT astro_gmst(2451545.0) >= 0 AND astro_gmst(2451545.0) < 24;
----
true

# GMST advances by ~24h per Earth rotation (~0.99727 sidereal day per solar day)
# After 1 solar day, GMST advances by ~24.0657 hours mod 24 ≈ 0.0657 h ≈ 3m 56s
query I
SELECT abs((astro_gmst(2451546.0) - astro_gmst(2451545.0)) - 0.0657098) < 0.001;
----
true

# LMST at longitude 0 must equal GMST
query I
SELECT abs(astro_lmst(2451545.0, 0.0) - astro_gmst(2451545.0)) < 1e-9;
----
true

# LMST at longitude +15 deg = GMST + 1 hour
query I
SELECT abs(astro_lmst(2451545.0, 15.0) - (astro_gmst(2451545.0) + 1.0)) < 1e-9;
----
true

# LMST is in [0, 24) for any input
query I
SELECT astro_lmst(2451545.0, 180.0) >= 0 AND astro_lmst(2451545.0, 180.0) < 24;
----
true

# Hour angle: ra=15 deg = 1h, lmst=10h → HA = 9h
query I
SELECT astro_hour_angle(15.0, 10.0) = 9.0;
----
true

# Hour angle wraps to (-12, 12]
query I
SELECT astro_hour_angle(345.0, 10.0) = 11.0;  -- 10 - 23 = -13 → +24 → 11
----
true

query I
SELECT astro_hour_angle(180.0, 10.0) = -2.0;  -- 10 - 12 = -2
----
true

# astro_altaz_from_radec: object at celestial pole (dec=90)
# alt should equal observer latitude
query I
SELECT abs((astro_altaz_from_radec(0.0, 90.0, 0.0, 53.55)).alt_deg - 53.55) < 1e-9;
----
true

# Equatorial object on the meridian (ra=lmst, dec=0): alt = 90 - lat, az = 180 (south)
query I
SELECT abs((astro_altaz_from_radec(0.0, 0.0, 0.0, 45.0)).alt_deg - 45.0) < 1e-9;
----
true

query I
SELECT abs((astro_altaz_from_radec(0.0, 0.0, 0.0, 45.0)).az_deg - 180.0) < 1e-9;
----
true

# Equatorial object rising in the east (HA = -6h): alt = 0, az = 90 (east)
# RA = 90 deg = 6h, LMST = 0 → HA = 0 - 6 = -6 h
query I
SELECT abs((astro_altaz_from_radec(90.0, 0.0, 0.0, 45.0)).alt_deg - 0.0) < 1e-9;
----
true

query I
SELECT abs((astro_altaz_from_radec(90.0, 0.0, 0.0, 45.0)).az_deg - 90.0) < 1e-9;
----
true

# Altitude must be in [-90, 90] for any input
query I
SELECT (astro_altaz_from_radec(123.45, -67.89, 14.5, -33.9)).alt_deg BETWEEN -90.0 AND 90.0;
----
true

# Azimuth must be in [0, 360) for any input
query I
SELECT (astro_altaz_from_radec(123.45, -67.89, 14.5, -33.9)).az_deg BETWEEN 0.0 AND 360.0;
----
true
